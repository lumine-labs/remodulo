{
    "name": "@remodulo/view-model",
    "version": "0.1.0",
    "description": "The remodulo view model base class: sealed lifecycle hooks, mount-scoped disposers and abort signal. Zero dependencies, reactivity-agnostic.",
    "license": "MIT",
    "author": "Egor Arkhipov (Lumine Labs)",
    "repository": {
        "type": "git",
        "url": "https://github.com/lumine-labs/remodulo"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "view-model",
        "lifecycle",
        "disposer",
        "abortcontroller",
        "remodulo",
        "typescript",
        "frontend-architecture"
    ],
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "typecheck:build": "tsc -p tsconfig.build.json --noEmit",
        "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
        "build": "pnpm run clean && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepack": "pnpm run build"
    },
    "devDependencies": {
        "@remodulo/container": "workspace:*",
        "@remodulo/react": "workspace:*",
        "@types/node": "^25.5.0",
        "@vitest/coverage-v8": "^4.1.0",
        "rimraf": "^6.1.3",
        "typescript": "^5.9.3",
        "vitest": "^4.1.0"
    }
}
