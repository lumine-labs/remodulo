{
    "name": "@remodulo/container",
    "version": "0.4.0",
    "description": "The remodulo dependency injection container: zero runtime dependencies, no decorators, injection through an ambient construction frame.",
    "license": "MIT",
    "author": "Egor Arkhipov (Lumine Labs)",
    "repository": {
        "type": "git",
        "url": "https://github.com/lumine-labs/remodulo"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "dependency-injection",
        "di",
        "ioc",
        "container",
        "remodulo",
        "typescript",
        "frontend-architecture"
    ],
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./types": {
            "types": "./dist/types.d.ts",
            "import": "./dist/types.js",
            "default": "./dist/types.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "typecheck:build": "tsc -p tsconfig.build.json --noEmit",
        "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
        "build": "pnpm run clean && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:memory": "node ./tests/memory/run-memory-tests.mjs",
        "prepack": "pnpm run build"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "@vitest/coverage-v8": "^4.1.0",
        "rimraf": "^6.1.3",
        "typescript": "^5.9.3",
        "vitest": "^4.1.0"
    }
}
