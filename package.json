{
    "name": "remodulo",
    "private": true,
    "type": "module",
    "license": "MIT",
    "author": "Egor Arkhipov (Lumine Labs)",
    "repository": {
        "type": "git",
        "url": "https://github.com/lumine-labs/remodulo"
    },
    "engines": {
        "node": ">=18"
    },
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "build": "pnpm -r run build",
        "test": "pnpm -r run test",
        "typecheck": "pnpm -r run typecheck",
        "clean": "pnpm -r run clean",
        "typecheck:build": "pnpm --filter @remodulo/container --filter @remodulo/view-model --filter @remodulo/react --filter @remodulo/mobx run typecheck:build",
        "typecheck:tests": "pnpm --filter @remodulo/container --filter @remodulo/view-model --filter @remodulo/react --filter @remodulo/mobx run typecheck:tests",
        "typecheck:consumers": "pnpm --filter @remodulo/react run typecheck:consumers",
        "test:watch": "pnpm --filter @remodulo/react run test:watch",
        "test:coverage": "pnpm --filter @remodulo/react run test:coverage",
        "test:memory": "pnpm --filter @remodulo/container --filter @remodulo/react --workspace-concurrency=1 run test:memory",
        "docs:dev": "pnpm --filter @remodulo/docs run docs:dev",
        "docs:build": "pnpm --filter @remodulo/docs run docs:build",
        "docs:preview": "pnpm --filter @remodulo/docs run docs:preview"
    },
    "devDependencies": {
        "@luminelabs/eslint-config": "^0.4.1",
        "eslint": "^9.39.0",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3"
    }
}
